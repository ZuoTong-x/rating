# PostgreSQL 数据库名称、用户和密码（密码请替换为强密码）
POSTGRES_DB=image_rating
POSTGRES_USER=image_rating
POSTGRES_PASSWORD=change-me

# Web 对外端口和上传/导入文件的宿主机持久化数据根目录
WEB_PORT=8080
RATING_DATA_DIR=/data/sunwenxiu/rating

# PostgreSQL 数据目录（建议使用本机 ext4 磁盘，不要放在 /data）
POSTGRES_DATA_DIR=/var/lib/rating/postgres

# API 数据库连接池与 SQL 超时（100 人规模建议保持当前值）
PG_POOL_MAX=24
PG_STATEMENT_TIMEOUT_MS=60000
PG_LOCK_TIMEOUT_MS=2000

# 任务批量写入大小，默认 1000；若单任务包含很多图片可降到 500
TASK_WRITE_BATCH_SIZE=1000
TASK_ASSIGN_BATCH_SIZE=1000

# 导入并发和数据库批量写入大小
IMAGE_IMPORT_CONCURRENCY=4
IMPORT_DB_BATCH_SIZE=1000
IMPORT_DB_ITEM_BATCH_SIZE=5000

# 登录安全：通过反向代理访问时填写 TRUST_PROXY，例如 1
TRUST_PROXY=1
# 多实例部署必须使用所有 API 实例相同的随机密钥
AUTH_CAPTCHA_SECRET=请替换为至少 32 位随机字符串
